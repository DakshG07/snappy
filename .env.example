DATABASE_PATH=backend/data/scanny.db
DOCUMENT_STORAGE_PATH=backend/data/documents
PADDLE_CACHE_PATH=backend/data/paddle
FRONTEND_DIST_PATH=frontend/build
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=90
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_TIMEOUT_SECONDS=25
EMBEDDING_MAX_INPUT_CHARS=12000
SEMANTIC_SEARCH_MIN_SCORE=0.55
SEMANTIC_SEARCH_MAX_RESULTS=10
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.65
SCAN_CONFIDENCE_THRESHOLD=0.60
SCAN_DENOISE_STRENGTH=4
SCAN_BACKGROUND_SIGMA=25
SCAN_CLAHE_CLIP_LIMIT=1.5
SCAN_CLAHE_TILE_SIZE=8
SCAN_SHARPEN_AMOUNT=0.25
SCAN_BW_BLOCK_SIZE=31
SCAN_BW_C=9
DEBUG=false
SESSION_DAYS=30
SECURE_COOKIES=false
